/* ========================================
   組名入力画面
======================================== */

.kumiwake-group-names {
  width: 100vw;
  height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  overflow: hidden;

  background-image: url("<%= asset_path('kumiwake-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  color: #222;
  font-family: "Courier New", monospace;
}


/* ========================================
   羊皮紙パネル
======================================== */

.kumiwake-group-names-panel {
  position: relative;

  width: min(75vw, 500px);
  aspect-ratio: 2 / 3;

  padding: 50px 45px 40px;

  box-sizing: border-box;

  background: transparent;

  border: none;

  box-shadow: none;

  overflow: hidden;
}


/* ========================================
   羊皮紙背景
======================================== */

.kumiwake-group-names-panel::before {
  content: "";

  position: absolute;
  inset: 0;

  background-image: url("<%= asset_path('input-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  opacity: 0.9;

  z-index: 0;
}


/* ========================================
   内容を背景より前へ
======================================== */

.kumiwake-group-names-panel > * {
  position: relative;

  z-index: 1;
}


/* ========================================
   タイトル
======================================== */

.kumiwake-group-names-panel h2 {
  margin: 0 0 10px;

  text-align: center;

  font-size: 26px;

  color: #222;
}


/* ========================================
   説明文
======================================== */

.group-name-description,
.group-name-limit {
  margin: 0;

  text-align: center;

  font-size: 17px;

  line-height: 1.6;

  color: #222;
}

.group-name-description {
  margin-bottom: 4px;
}

.group-name-limit {
  margin-bottom: 20px;

  font-size: 15px;
}


/* ========================================
   組名入力エリア
======================================== */

.group-name-list {
  display: flex;

  flex-direction: column;

  gap: 12px;

  width: 100%;

  height: 360px;

  overflow-y: auto;

  padding-right: 8px;

  box-sizing: border-box;

  scrollbar-width: thin;
  scrollbar-color: rgba(60, 40, 20, 0.35) transparent;
}


/* ========================================
   1つの組名入力行
======================================== */

.group-name-row {
  display: flex;

  align-items: center;

  gap: 10px;

  width: 80%;

  margin: 0 auto;
}


/* ========================================
   番号
======================================== */

.group-name-row span {
  width: 35px;

  flex-shrink: 0;

  text-align: right;

  font-size: 16px;

  color: #222;
}


/* ========================================
   組名入力欄
======================================== */

.group-name-row input {
  flex: 1;

  width: 100%;
  min-width: 0;

  padding: 8px 10px;

  box-sizing: border-box;

  background: transparent;

  border: none;

  border-bottom: 1px solid rgba(60, 40, 20, 0.6);

  border-radius: 0;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 15px;

  outline: none;
}


/* フォーカス時 */

.group-name-row input:focus {
  background: transparent;

  border-bottom-color: #222;

  box-shadow: none;
}


/* ========================================
   ＋ − ボタン
======================================== */

.group-name-submit {
  display: flex;
  justify-content: center;
  margin-top: 20px;
}


/* ========================================
   ＋ − 決定ボタン
======================================== */

.group-name-controls {
  display: flex;

  justify-content: center;

  align-items: center;

  gap: 20px;

  margin-top: 20px;
}


/* 共通ボタン */

.group-name-controls button {
  padding: 9px 16px;

  background: transparent;

  border: 2px solid #222;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 15px;

  cursor: pointer;
}


/* ＋ − ボタン */

.group-name-controls button:first-child,
.group-name-controls button:nth-child(2) {
  width: 42px;

  padding: 8px 0;

  font-size: 20px;
}


/* ホバー */

.group-name-controls button:hover {
  background: rgba(255, 255, 255, 0.12);
}


/* ========================================
   決定ボタン
======================================== */

.group-name-submit {
  display: flex;

  justify-content: center;

  margin-top: 20px;
}


.group-name-submit button {
  padding: 10px 25px;

  background: transparent;

  border: 2px solid #222;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 15px;

  cursor: pointer;
}


.group-name-submit button:hover {
  background: rgba(255, 255, 255, 0.12);
}


/* ========================================
   スマートフォン
======================================== */

@media (max-width: 700px) {

  /* ========================================
     パネル
  ======================================== */

  .kumiwake-group-names-panel {
    width: 95%;

    height: 80%;

    padding: 110px 30px 25px;

    box-sizing: border-box;
  }


  /* ========================================
     羊皮紙
  ======================================== */

  .kumiwake-group-names-panel::before {
    background-size: contain;

    background-position: center;

    background-repeat: no-repeat;
  }


  /* ========================================
     タイトル
  ======================================== */

  .kumiwake-group-names-panel h2 {
    font-size: 22px;

    margin-bottom: 6px;
  }


  /* ========================================
     説明文
  ======================================== */

  .group-name-description {
    font-size: 14px;

    margin-bottom: 4px;
  }


  .group-name-limit {
    font-size: 13px;

    margin-bottom: 10px;
  }


  /* ========================================
     組名入力エリア
  ======================================== */

  .group-name-list {
    width: 100%;

    height: 350px;

    gap: 9px;

    overflow-y: auto;

    padding-right: 5px;
  }


  /* ========================================
     入力行
  ======================================== */

  .group-name-row {
    width: 85%;

    margin: 0 auto;

    gap: 6px;
  }


  .group-name-row span {
    width: 25px;

    font-size: 13px;
  }


  .group-name-row input {
    font-size: 13px;

    padding: 5px 6px;
  }


  /* ========================================
     ＋ −
  ======================================== */

 @media (max-width: 700px) {

  .group-name-controls {
    gap: 12px;

    margin-top: 10px;
  }

  .group-name-controls button {
    padding: 7px 12px;

    font-size: 13px;
  }

  .group-name-controls button:first-child,
  .group-name-controls button:nth-child(2) {
    width: 36px;

    padding: 6px 0;

    font-size: 18px;
  }

}

}