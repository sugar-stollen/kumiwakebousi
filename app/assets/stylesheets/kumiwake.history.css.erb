/* ========================================
   組み分け履歴画面
======================================== */

.kumiwake-history {
  width: 100vw;
  height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  overflow: hidden;

  background-image: url("<%= asset_path('kumiwake-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  color: #222;
  font-family: "Courier New", monospace;
}


/* ========================================
   羊皮紙パネル
======================================== */

.kumiwake-history-panel {
  position: relative;

  width: min(75vw, 500px);
  aspect-ratio: 2 / 3;

  padding: 65px 45px 35px;

  box-sizing: border-box;

  background: transparent;

  border: none;

  box-shadow: none;

  overflow: hidden;
}


/* ========================================
   羊皮紙背景
======================================== */

.kumiwake-history-panel::before {
  content: "";

  position: absolute;

  inset: 0;

  background-image: url("<%= asset_path('input-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  opacity: 0.9;

  z-index: 0;
}


/* ========================================
   内容を背景より前へ
======================================== */

.kumiwake-history-panel > * {
  position: relative;

  z-index: 1;
}


/* ========================================
   タイトル
======================================== */

.kumiwake-history-panel h1 {
  margin: 5px 0 20px;

  text-align: center;

  font-size: 26px;

  color: #222;
}


/* ========================================
   履歴スクロール部分
======================================== */

.history-scroll {
  width: 100%;

  height: 390px;

  overflow-y: auto;

  padding: 0 12px 10px 8px;

  box-sizing: border-box;

  scrollbar-width: thin;
  scrollbar-color: rgba(60, 40, 20, 0.35) transparent;
}


/* ========================================
   履歴がない場合のメッセージ
======================================== */

.no-history {
  width: 100%;

  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  font-size: 16px;

  color: #666;
}


/* ========================================
   1つの履歴アイテム（1回分の結果）
======================================== */

.history-item {
  width: 85%;

  margin: 0 auto 20px;

  padding: 10px 10px 15px;

  border: 1px solid rgba(60, 40, 20, 0.2);

  border-radius: 3px;

}


/* ========================================
   履歴アイテムの回数タイトル
======================================== */

.history-item h2 {
  margin: 0 0 10px;

  text-align: left;

  font-size: 18px;

  color: #222;

  font-weight: bold;
}


/* ========================================
   履歴内の組
======================================== */

.history-group {
  width: 95%;

  margin: 0 auto 8px;
}


/* ========================================
   履歴内の組名
======================================== */

.history-group h3 {
  margin: 0 0 5px;

  text-align: left;

  font-size: 15px;

  color: #333;

  font-weight: bold;
}


/* ========================================
   履歴内の名前
======================================== */

.history-group p {
  margin: 2px 0;

  padding: 2px 5px 2px 10px;

  text-align: center;

  font-size: 14px;

  line-height: 1.3;

  color: #222;

  border-bottom: 1px solid rgba(60, 40, 20, 0.15);
}


/* ========================================
   下部ボタンエリア
======================================== */

.history-menu {
  position: absolute;

  left: 45pcx;
  right: 45px;
  bottom: 85px;

  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 12px;

  margin-right: 25%;

}


/* ========================================
   戻るボタン
======================================== */

.history-menu a {
   width: 100%;

  box-sizing: border-box;

  padding: 10px 10px;

  background: transparent;

  border: 2px solid #222;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 12px;

  text-align: center;

  text-decoration: none;

  cursor: pointer;
  
  justify-content: center;
}


/* ========================================
   戻るボタンのホバー
======================================== */

.history-menu a:hover {
  background: rgba(255, 255, 255, 0.12);
}


/* ========================================
   スマートフォン
======================================== */

@media (max-width: 700px) {

  /* ========================================
     パネル
  ======================================== */

  .kumiwake-history-panel {
    width: 95%;

    height: 80%;

    padding: 105px 30px 25px;

    box-sizing: border-box;
  }


  /* ========================================
     羊皮紙
  ======================================== */

  .kumiwake-history-panel::before {
    opacity: 0.85;
  }


  /* ========================================
     スクロール部分の高さ
  ======================================== */

  .history-scroll {
    height: 350px;
  }


  /* ========================================
     下部ボタンの位置
  ======================================== */

  .history-menu {
    left: 45px;
    right: 30px;
    bottom: 55px;
  }


  /* ========================================
     戻るボタンの幅
  ======================================== */

  .history-menu a {
    width: 70%;
  }

}
