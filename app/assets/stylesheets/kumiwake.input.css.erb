/* ========================================
   名簿入力画面
======================================== */

.kumiwake-input {
  width: 100vw;
  height: 100vh;

  display: flex;
  justify-content: center;
  align-items: center;

  overflow: hidden;

  background-image: url("<%= asset_path('kumiwake-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  color: #222;
  font-family: "Courier New", monospace;
}

/* ========================================
   名簿入力パネル
======================================== */

.kumiwake-input-panel {
  position: relative;

  width: min(75vw, 500px);
  aspect-ratio: 2 / 3;

  padding: 50px 45px 40px;

  box-sizing: border-box;

  background: transparent;

  border: none;

  box-shadow: none;

  overflow-y: hidden;
}

/* ========================================
   パネル内の背景画像
======================================== */

.kumiwake-input-panel::before {
  content: "";

  position: absolute;
  inset: 0;

  background-image: url("<%= asset_path('input-background.png') %>");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;

  opacity: 0.9;

  z-index: 0;
}

/* ========================================
   背景画像より内容を前に出す
======================================== */

.kumiwake-input-panel > * {
  position: relative;

  z-index: 1;
}


/* ========================================
   タイトル
======================================== */

.kumiwake-input-panel h2 {
  margin: 0 0 10px;

  text-align: center;

  font-size: 26px;

  color: #222;
}


/* ========================================
   説明文
======================================== */

.input-message {
  margin: 0 0 20px;

  text-align: center;

  font-size: 18px;

  line-height: 1.6;

  color: #222;
}


/* ========================================
   名前入力欄
======================================== */

.name-inputs {
  width: 100%;
}

.name-input-list {
  display: flex;
  flex-direction: column;

  gap: 9px;

  width: 100%;

  height: 410px;

  overflow-y: auto;

  padding-right: 8px;

  box-sizing: border-box;

   /* Firefox */
  scrollbar-width: thin;
  scrollbar-color: rgba(60, 40, 20, 0.35) transparent;

}

/* 1つの入力欄 */

.name-input-row {
  display: flex;

  align-items: center;

  gap: 10px;

  width: 80%;

  margin: 0 auto;
}

/* 番号 */

.name-input-row span {
  width: 35px;

  flex-shrink: 0;

  text-align: right;

  font-size: 16px;

  color: #222;
}


/* 名前入力 */

.name-input-row input {
  flex: 1;

  width: 100%;
  min-width: 0;

  padding: 8px 10px;

  box-sizing: border-box;

  background: transparent;

  border: none;
  border-bottom: 1px solid rgba(60, 40, 20, 0.6);
  border-radius: 0;

  color: #222;

  font-family: "Courier New", monospace;
  font-size: 15px;

  outline: none;
}


.name-input-row input:focus {
  background: transparent;

  border-bottom-color: #222;

  box-shadow: none;
}


/* ========================================
   下部ボタン
======================================== */

.input-buttons {
  display: flex;

  justify-content: center;

  gap: 30px;

  margin-top: 20px;

  transform: translateX(-30px);
}


/* 共通ボタン */

.input-buttons button {
  padding: 10px 15px;

  background: transparent;

  border: 2px solid #222;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 15px;

  cursor: pointer;
}


/* マウスを乗せたとき */

.input-buttons button:hover {
  background: rgba(255, 255, 255, 0.12);
}


/* ========================================
   以下　スマートフォン用配置
======================================== */
@media (max-width: 700px) {

  /* ========================================
     パネル
  ======================================== */

  .kumiwake-input-panel {
    width: 95%;
    height: 80%;

    padding: 110px 30px 25px;

    box-sizing: border-box;
    
  }


  /* ========================================
     羊皮紙の背景
  ======================================== */

  .kumiwake-input-panel::before {
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
  }


  /* ========================================
     タイトル
  ======================================== */

  .kumiwake-input-panel h2 {
    font-size: 22px;

    margin-bottom: 6px;
  }


  /* ========================================
     説明文
  ======================================== */

  .input-message {
    font-size: 14px;

    margin-bottom: 10px;
  }


  /* ========================================
     名前入力エリア
  ======================================== */

  .name-input-list {
    width: 100%;

    height: 350px;

    overflow-y: auto;

    padding-right: 5px;
  }


  /* ========================================
     名前入力行
  ======================================== */

  .name-input-row {
    width: 85%;

    margin: 0 auto;

    gap: 6px;
  }


  .name-input-row span {
    width: 25px;

    font-size: 13px;
  }


  .name-input-row input {
    font-size: 13px;

    padding: 5px 6px;
  }


  /* ========================================
     ボタン
  ======================================== */

  .input-buttons {
    display: flex;

    flex-direction: row;

    justify-content: center;

    align-items: center;

    gap: 12px;

    margin-top: 1px;

    transform: none;
  }


  .input-buttons button {
    width: auto;

    min-width: 80px;

    padding: 7px 9px;

    font-size: 13px;
  }

.group-count-input {
  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 15px;

  color: #222;
}


.group-count-description {
  margin: 0;

  font-size: 20px !important;

  text-align: center;

  line-height: 1.6;
}

#group-count-value {
  width: 140px;

  padding: 10px;

  box-sizing: border-box;

  background: transparent;

  border: 1px solid #555;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 22px;

  text-align: center;
}

.group-count-submit {
  padding: 10px 30px;

  background: transparent;

  border: 1px solid #555;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 18px;

  cursor: pointer;
}

/* ========================================
   組名入力
======================================== */

.group-name-input {
  width: 100%;
  height: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;

  color: #222;
}

.group-name-description {
  margin: 0 0 15px;

  text-align: center;

  font-size: 16px;
}

.group-name-list {
  width: 80%;

  display: flex;
  flex-direction: column;

  gap: 10px;

  overflow-y: auto;
}

.group-name-row {
  display: flex;

  align-items: center;

  gap: 10px;

  width: 100%;
}

.group-name-row span {
  width: 25px;

  text-align: right;

  font-size: 16px;
}

.group-name-row input {
  flex: 1;

  padding: 8px;

  box-sizing: border-box;

  background: rgba(255, 255, 255, 0.25);

  border: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.5);

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 18px;

  outline: none;
}

.group-name-row input::placeholder {
  color: rgba(0, 0, 0, 0.35);
}

.group-name-row input:focus {
  border-bottom-color: #222;
}

.group-name-submit {
  margin-top: 15px;

  padding: 8px 25px;

  background: transparent;

  border: 1px solid #555;

  border-radius: 3px;

  color: #222;

  font-family: "Courier New", monospace;

  font-size: 16px;

  cursor: pointer;
}
}