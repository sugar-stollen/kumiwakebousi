.splash-screen {
  display: grid;
  width: 100%;
  min-height: 100vh;
  place-items: center;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 50% 38%, rgba(97, 71, 42, 0.18), transparent 48%),
    linear-gradient(180deg, rgba(14, 18, 25, 0.2), rgba(8, 11, 16, 0.78)),
    url("<%= asset_path('background.png') %>") center / cover no-repeat;
  color: #fff7e8;
  text-align: center;
  font-family: "Courier New", monospace;
}

.splash-frame {
  display: grid;
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 40px;
  place-items: center;
}

.splash-content {
  width: min(90%, 660px);
  padding: 30px 24px;
  animation: splash-arrive 900ms ease-out both;
}

.splash-logo {
  display: block;
  width: min(100%, 940px);
  object-fit: contain;
  margin: 0 auto;
  filter: drop-shadow(0 8px 22px rgba(0, 0, 0, 0.65));
}

.splash-caption {
  margin: 12px 0 34px;
  color: rgba(255, 247, 232, 0.88);
  font-family: "Yu Mincho", "Hiragino Mincho ProN", serif;
  font-size: clamp(14px, 2.2vw, 18px);
  letter-spacing: 0.18em;
}

.splash-start {
  display: inline-block;
  min-width: 220px;
  box-sizing: border-box;
  padding: 15px 30px;
  border: 1px solid #e5c88d;
  border-radius: 2px;
  background: rgba(18, 20, 23, 0.72);
  color: #fff7e8;
  font: inherit;
  font-size: 18px;
  letter-spacing: 0.2em;
  text-decoration: none;
  transition: background 180ms ease, color 180ms ease, transform 180ms ease;
}

.splash-start span {
  margin-right: 10px;
  color: #e5c88d;
  font-size: 13px;
}

.splash-start:hover,
.splash-start:focus-visible {
  transform: translateY(-2px);
  background: #e5c88d;
  color: #1b1b1a;
  outline: none;
}

.splash-start:hover span,
.splash-start:focus-visible span {
  color: #1b1b1a;
}

.splash-hint {
  margin: 16px 0 0;
  color: rgba(255, 247, 232, 0.55);
  font-size: 11px;
  letter-spacing: 0.12em;
}

@keyframes splash-arrive {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 600px) {
  .splash-frame { padding: 24px; }
  .splash-logo { max-height: 36vh; }
}
