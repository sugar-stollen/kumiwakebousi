<div class="kumiwake">
  <main class="home-screen" data-controller="kumiwake">

  <!-- 帽子 -->
  <div class="hat-area">
    <div class="hat-image"></div>
  </div>

  <!-- 下部コマンドエリア -->
  <div class="command-area">

    <!-- セリフ -->
    <div class="message-box">
      <p data-kumiwake-target="message"></p>
    </div>

    <!-- 選択肢 -->
    <div class="menu-box" data-kumiwake-target="menu">

      <%= link_to kumiwake_input_path, class: "menu-item" do %>
        <span class="cursor">▶</span>
        入力する
      <% end %>

      <button class="menu-item">
        <span class="cursor">▶</span>
        CSVからインポート
      </button>

    </div>

  </div>

</div>