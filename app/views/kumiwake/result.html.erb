<div class="kumiwake-result">

  <div class="kumiwake-result-panel">

    <h1>組み分け結果</h1>

    <!-- 組み分け結果だけスクロールする部分 -->
    <div class="group-results-scroll">

      <% @groups.each_with_index do |group, index| %>

        <div class="group-result">

          <h2>
            <%= @group_names[index] %>
          </h2>

          <% group.each do |member| %>
            <p>
              <%= member["name"] %>
            </p>
          <% end %>

        </div>

      <% end %>

    </div>

    <!-- 下部固定ボタン -->
    <div class="result-menu">

      <!-- 組み分けを続ける -->
      <% if @normal_mode %>

        <%= form_with url: kumiwake_draw_path,
                      method: :post,
                      local: true do %>

          <%= hidden_field_tag :normal_mode, "true" %>

          <button type="submit">
            組み分けを続ける
          </button>

        <% end %>

      <% else %>

        <%= button_to "組み分けを続ける",
                      kumiwake_draw_path,
                      method: :post %>

      <% end %>


      <!-- 終わる -->
      <%= link_to "終わる", kumiwake_finish_path, class: "finish-button" %>
      

      <!-- CSV -->
      <button type="button" class="csv-button">
        CSVエクスポート
      </button>

    </div>

  </div>

</div>