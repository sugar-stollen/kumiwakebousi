<div class="kumiwake-result">

  <h1>組み分け結果</h1>

  <% @groups.each_with_index do |group, index| %>

    <div class="group-result">

      <h2>
        <%= @group_names[index] %>
      </h2>

      <% group.each do |member| %>

        <p>
          <%= member["name"] %>
        </p>

      <% end %>

    </div>

  <% end %>


  <div class="result-menu">

    <!-- 2回目以降 -->
    <% if @draw_count >= 2 %>

      <button type="button">
        履歴
      </button>

    <% end %>


    <!-- 次の組み分け -->
    <%= button_to "組み分けをつづける",
                  kumiwake_draw_path,
                  method: :post %>


    <!-- CSV -->
    <button type="button">
      CSVエクスポート（未実装）
    </button>


    <!-- 終わる -->
    <%= button_to "終わる",
                  "/kumiwake/finish",
                  method: :post %>

  </div>

</div>