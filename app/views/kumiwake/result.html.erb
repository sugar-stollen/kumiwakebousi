<div class="kumiwake-result">

  <div class="kumiwake-result-panel">

    <h1>
      組み分け結果
      <span>第<%= @round_number %>回目</span>
    </h1>

    <!-- 組み分け結果だけスクロールする部分 -->
    <div class="group-results-scroll">

      <% @groups.each_with_index do |group, index| %>

        <div class="group-result">

          <h2>
            <%= @group_names[index] %>
          </h2>

          <% group.each do |member| %>
            <p>
              <%= member["name"] %>
            </p>
          <% end %>

        </div>

      <% end %>

    </div>

    <!-- 下部固定ボタン -->
    <div class="result-menu">

      <!-- 組み分けを続ける -->
      <% if !@magic_mode %>

        <%= form_with url: kumiwake_draw_path,
                      method: :post,
                      local: true,
                      data: { turbo: false } do %>

          <%= hidden_field_tag :switch_to_normal, "true" %>
          <%= hidden_field_tag :magic_mode, "false" %>

          <button type="submit">
            組み分けを続ける
          </button>

        <% end %>

      <% else %>

        <%= button_to "組み分けを続ける",
                      kumiwake_draw_path,
                      method: :post,
                      form: { data: { turbo: false } } %>

      <% end %>


      <!-- 終わる -->
      <%= link_to "終わる", kumiwake_finish_path, class: "finish-button" %>
      

      <% if @show_history_button %>
        <!-- 履歴 -->
        <%= link_to "履歴", kumiwake_history_path,
              class: "history-button",
              data: { turbo: false } %>
      <% end %>

      <!-- CSV -->
      <%= link_to csv_export_path, class: "csv-button" do %>
        CSVエクスポート
      <% end %>

    </div>

  </div>

</div>