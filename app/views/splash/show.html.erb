<main class="splash-screen">
  <div class="splash-frame">
    <div class="splash-content">
      <%= image_tag "kumiwakerogo.png", class: "splash-logo", alt: "組み分け帽子" %>
      <p class="splash-caption">被らない組み分けをしよう</p>
      <%= link_to home_index_path, class: "splash-start" do %>
        <span aria-hidden="true">▶</span> はじめる
      <% end %>
      <p class="splash-hint">クリックしてスタート</p>
    </div>
  </div>
</main>
